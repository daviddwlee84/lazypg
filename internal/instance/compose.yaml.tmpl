# Generated by lazypg. Local development only: listens on loopback.
name: {{.Name}}
services:
  db:
    image: {{.Image}}
    restart: unless-stopped
    environment:
      POSTGRES_USER: {{.User}}
      POSTGRES_PASSWORD: {{.Password}}
      POSTGRES_DB: postgres
    ports:
      - "127.0.0.1:${LAZYPG_PORT:?LAZYPG_PORT is set by lazypg}:5432"
    volumes:
      - pgdata:{{.DataPath}}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{.User}} -d postgres"]
      interval: 2s
      timeout: 5s
      retries: 30
volumes:
  pgdata:
